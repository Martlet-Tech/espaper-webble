CONFIG_BT_CTRL_BLE_LLCP_CHAN_MAP_UPDATE=y
CONFIG_BT_CTRL_BLE_LLCP_PHY_UPDATE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
